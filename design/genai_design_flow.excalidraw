      "seed": 520937718,
      "version": 617,
      "versionNonce": 276062902,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1762292264908,
      "link": null,
      "locked": false,
      "text": "🔔 InterviewSubmitted → triggers: transcription worker, email confirmation, analytics update\n🔔 TranscriptionCompleted → triggers: AI scoring worker, status update to \"processing\"\n🔔 CandidateScored → triggers: notification to HR (WebSocket), email to candidate, analytics aggregation, cache invalidation\n\nSubscribers: API Gateway (WebSocket server), Analytics service, Notification service, Cache invalidator\nBenefits: Loose coupling | Event sourcing | Audit trail | Real-time reactivity | Scalability",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "event-bus-box",
      "originalText": "🔔 InterviewSubmitted → triggers: transcription worker, email confirmation, analytics update\n🔔 TranscriptionCompleted → triggers: AI scoring worker, status update to \"processing\"\n🔔 CandidateScored → triggers: notification to HR (WebSocket), email to candidate, analytics aggregation, cache invalidation\n\nSubscribers: API Gateway (WebSocket server), Analytics service, Notification service, Cache invalidator\nBenefits: Loose coupling | Event sourcing | Audit trail | Real-time reactivity | Scalability",
      "autoResize": true,
      "lineHeight": 1.25
    },
